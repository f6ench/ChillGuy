# Betfair API credentials
BETFAIR_USERNAME=your_username
BETFAIR_PASSWORD=your_password
BETFAIR_APP_KEY=your_app_key
BETFAIR_CERTS_PATH=./certs

# Anthropic API
ANTHROPIC_API_KEY=your_anthropic_api_key

# Trading settings
PAPER_TRADING=true
MAX_STAKE=2.00
MAX_LIABILITY=10.00
KELLY_FRACTION=0.25
BETFAIR_COMMISSION=0.05

# Strategy settings
MIN_EDGE=0.05
MIN_CONFIDENCE=0.6
SCALP_TICKS=2

# Racing API (form data — racingapi.pro)
RACING_API_KEY=your_racing_api_key

# Race selection filters
FILTER_MIN_LIQUIDITY=50000
FILTER_MIN_CLASS=1
FILTER_MAX_CLASS=4
FILTER_MIN_FIELD=6
FILTER_MAX_FIELD=16
FILTER_FLAT_ONLY=true
FILTER_EXCLUDE_MAIDENS=true

# Steam detection thresholds
STEAM_THRESHOLD=0.15
DRIFT_THRESHOLD=-0.20
VOLUME_THRESHOLD=0.10
